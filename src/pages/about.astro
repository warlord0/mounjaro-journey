---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { authorSlug, getAllAuthors, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const authors = getAllAuthors(allPosts);
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.name} — what it publishes and who writes it.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">About</p>
        <h1 class="pagehead-title">{siteConfig.name}</h1>
        <p class="pagehead-description">{siteConfig.about}</p>
      </header>

      <div class="prose">
        <h2>What gets published here</h2>
        <p>
          Notes on what it's actually like being on Mounjaro (tirzepatide): the appetite changes, the
          side effects, the weight, and the ongoing argument with food that the medication helps with
          but hasn't ended. Posts are written to be honest about what's still hard, not just what's
          working.
        </p>

        <h2>How it is written</h2>
        <p>
          Everything here is personal experience, not medical advice — what happened, when it
          happened, and how it felt at the time. If something changes later, that goes in too, rather
          than quietly editing the record.
        </p>

        <h2>Who writes it</h2>
        <ul>
          {
            authors.map((author) => (
              <li>
                <a href={`/author/${authorSlug(author.name)}/`}>{author.name}</a> — {author.role} ({author.posts.length} {author.posts.length === 1 ? "post" : "posts"})
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

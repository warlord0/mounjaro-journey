---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { formatDate, postHref, visiblePosts, type Post } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));

// allPosts is already newest-first, so Map insertion order keeps years and
// months in the right order without needing to sort anything again.
const byYearThenMonth = new Map<string, Map<string, Post[]>>();
for (const post of allPosts) {
  const year = post.data.date.getFullYear().toString();
  const month = post.data.date.toLocaleString(siteConfig.dateLocale, { month: "long" });

  const months = byYearThenMonth.get(year) ?? new Map<string, Post[]>();
  const postsInMonth = months.get(month) ?? [];
  postsInMonth.push(post);
  months.set(month, postsInMonth);
  byYearThenMonth.set(year, months);
}
const years = [...byYearThenMonth.entries()];
---

<BaseLayout
  title="Archives"
  description={`Every post on ${siteConfig.name}, grouped by year and month.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Index</p>
        <h1 class="pagehead-title">Archives</h1>
        <p class="pagehead-description">
          {allPosts.length} {allPosts.length === 1 ? "post" : "posts"}, by year and month.
        </p>
      </header>

      <div class="grid gap-14">
        {
          years.map(([year, months]) => (
            <section aria-labelledby={`year-${year}`}>
              <h2 id={`year-${year}`} class="text-3xl font-semibold tracking-tight">
                {year}
              </h2>
              <div class="mt-6 grid gap-8">
                {[...months.entries()].map(([month, posts]) => (
                  <div>
                    <h3 class="mb-4 text-xl font-bold tracking-tight">{month}</h3>
                    <ul class="grid gap-3">
                      {posts.map((post) => (
                        <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                          <a href={postHref(post)} class="link-title">
                            <span class="link-title__text font-medium">{post.data.title}</span>
                          </a>
                          <span class="shrink-0 text-sm text-muted-foreground">
                            {formatDate(post.data.date)}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

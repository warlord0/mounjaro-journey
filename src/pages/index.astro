---
import { getCollection } from "astro:content";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { lastKitKatDate, siteConfig } from "@/config/site";
import { categoryHref, getCategoryList, getFeatured, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const [latest, ...rest] = allPosts;
const feed = rest.slice(0, 8);
const featured = getFeatured(allPosts, 4).filter((post) => post.id !== latest?.id);
const categoryList = getCategoryList(allPosts);
const hasMore = rest.length > feed.length;
---

<BaseLayout>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="inner">
      <h1 class="sr-only">{siteConfig.name} — {siteConfig.tagline}</h1>

      {latest && (
        <section class="pt-10 pb-[var(--space-section)] md:pt-14" aria-label="Latest post">
          <PostCard post={latest} variant="lead" headingLevel="h2" dateLabel="Latest" />
        </section>
      )}

      <div class="grid gap-[var(--space-section)] lg:grid-cols-[minmax(0,4fr)_minmax(0,2fr)] lg:gap-12">
        <section aria-labelledby="more-posts">
          <h2 id="more-posts" class="section-title">More posts</h2>

          {feed.length > 0 ? (
            <div class="feed">
              {feed.map((post) => <PostCard post={post} />)}
            </div>
          ) : (
            <p class="text-muted-foreground">More posts are coming soon.</p>
          )}

          {hasMore && (
            <a href="/posts/" class="btn btn-outline btn-block mt-16">Browse the archive</a>
          )}
        </section>

        <aside class="sidebar">
          <section aria-labelledby="about-heading">
            <h2 id="about-heading" class="section-title">About</h2>
            <p class="text-lg font-semibold tracking-tight">{siteConfig.name}</p>
            <p class="mt-2 text-pretty text-sm leading-relaxed text-muted-foreground">{siteConfig.about}</p>
          </section>

          {featured.length > 0 && (
            <section aria-labelledby="featured-heading">
              <h2 id="featured-heading" class="section-title">Featured</h2>
              <div class="grid gap-7">
                {featured.map((post) => <PostCard post={post} variant="compact" headingLevel="h3" />)}
              </div>
            </section>
          )}

          {categoryList.length > 0 && (
            <section aria-labelledby="categories-heading">
              <h2 id="categories-heading" class="section-title">Categories</h2>
              <ul class="grid gap-4">
                {categoryList.map((category) => (
                  <li>
                    <a href={categoryHref(category.name)} class="link-title flex items-center justify-between gap-3">
                      <span class="link-title__text text-base font-semibold tracking-tight">{category.name}</span>
                      <span class="pill shrink-0">
                        {category.count} {category.count === 1 ? "post" : "posts"}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <section aria-labelledby="kitkat-heading">
            <h2 id="kitkat-heading" class="section-title">Days Since Last KitKat</h2>
            <p
              class="text-center text-5xl font-bold tracking-tight text-accent"
              data-kitkat-counter
              data-last-eaten={lastKitKatDate}
            >
              &nbsp;
            </p>
          </section>
        </aside>
      </div>
    </div>
  </main>
  <SiteFooter />

  <script>
    /*
     * Computed on the visitor's own clock so the number keeps climbing
     * day to day without needing a rebuild. Whole calendar days only,
     * not a rolling 24-hour count.
     */
    document.querySelectorAll("[data-kitkat-counter]").forEach((el) => {
      const lastEaten = el.getAttribute("data-last-eaten");
      if (!lastEaten) return;

      const [year, month, day] = lastEaten.split("-").map(Number);
      const last = Date.UTC(year, month - 1, day);

      const now = new Date();
      const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());

      const days = Math.round((today - last) / 86_400_000);
      el.textContent = String(Math.max(days, 0));
    });
  </script>
</BaseLayout>
